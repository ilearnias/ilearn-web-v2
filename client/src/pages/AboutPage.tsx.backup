import { useState, useRef, useCallback, useEffect } from 'react';
import PageTransition from '@/components/layout/PageTransition';
import { Helmet } from 'react-helmet';
import useEmblaCarousel from 'embla-carousel-react';

const timelineYears = Array.from({ length: 11 }, (_, i) => 2015 + i); // 2015 to 2025

const AboutPage = () => {
  const [activeYear, setActiveYear] = useState(2015); // Timeline starts from 2015 (earliest year)
  const [activeEventIndex, setActiveEventIndex] = useState(0); // Track current event within a year
  const [activeImageIndex, setActiveImageIndex] = useState(0);
  const [introImageIndex, setIntroImageIndex] = useState(0);
  const [touchStart, setTouchStart] = useState(0);
  const [touchEnd, setTouchEnd] = useState(0);
  const [selectedIndex, setSelectedIndex] = useState(0);
  
  // Initialize Embla Carousel
  const [emblaRef, emblaApi] = useEmblaCarousel({ loop: true, align: 'start' });
  
  // Carousel navigation functions
  const scrollCarousel = useCallback((direction: number) => {
    if (emblaApi) {
      emblaApi.scrollNext();
      const currentIndex = emblaApi.selectedScrollSnap();
      setSelectedIndex(currentIndex);
    }
  }, [emblaApi]);
  
  const scrollToSlide = useCallback((index: number) => {
    if (emblaApi) {
      emblaApi.scrollTo(index);
      setSelectedIndex(index);
    }
  }, [emblaApi]);
  
  // Update selected index when carousel scrolls
  useEffect(() => {
    if (!emblaApi) return;
    
    const onSelect = () => {
      setSelectedIndex(emblaApi.selectedScrollSnap());
    };
    
    emblaApi.on('select', onSelect);
    return () => {
      emblaApi.off('select', onSelect);
    };
  }, [emblaApi]);
  
  // Force the timeline to start at 2015 when component mounts
  useEffect(() => {
    setActiveYear(2015);
    setActiveEventIndex(0);
    setActiveImageIndex(0);
  }, []);
  
  // Introduction section images
  const introImages = [
    'https://images.unsplash.com/photo-1515187029135-18ee286d815b?ixlib=rb-1.2.1&auto=format&fit=crop&w=1470&q=80',
    'https://images.unsplash.com/photo-1523050854058-8df90110c9f1?ixlib=rb-1.2.1&auto=format&fit=crop&w=1470&q=80',
    'https://images.unsplash.com/photo-1606761568499-6d2451b23c66?ixlib=rb-1.2.1&auto=format&fit=crop&w=1470&q=80'
  ];
  
  // Timeline image assets
  const timelineAssets = [
    'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1497366754035-f200968a6e72?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1526379095098-d400fd0bf935?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80',
    'https://images.unsplash.com/photo-1581094794329-c8112a89af12?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80'
  ];

  // Mock timeline data for all years from 2015 to 2025 with multiple events per year, each with multiple images
  const timelineEvents: { 
    [year: number]: Array<{ 
      id: number; 
      title: string; 
      description: string; 
      images: string[] 
    }> 
  } = {
    2015: [
      {
        id: 1,
        title: 'Founded in Trivandrum',
        description: 'iLearn IAS Academy was established with a vision to provide quality civil service coaching in Kerala.',
        images: [timelineAssets[0], timelineAssets[3], timelineAssets[5]]
      },
      {
        id: 2,
        title: 'First Batch of Students',
        description: 'We welcomed our first batch of 25 dedicated civil service aspirants ready to begin their journey.',
        images: [timelineAssets[2], timelineAssets[4]]
      }
    ],
    2016: [
      {
        id: 1,
        title: 'First UPSC Success',
        description: 'Our first batch of students achieved remarkable success in the UPSC examination with multiple selections.',
        images: [timelineAssets[1], timelineAssets[4]]
      },
      {
        id: 2,
        title: 'Library Expansion',
        description: 'Added over 5,000 books and study materials to our campus library to support comprehensive preparation.',
        images: [timelineAssets[3], timelineAssets[5]]
      }
    ],
    2017: [
      {
        id: 1,
        title: 'Expanded to KAS Coaching',
        description: 'Launched specialized programs for Kerala Administrative Service examination to better serve state-level aspirants.',
        images: [timelineAssets[2], timelineAssets[5], timelineAssets[0]]
      },
      {
        id: 2,
        title: 'Mentorship Program',
        description: 'Introduced personalized mentorship program pairing each student with an experienced faculty member.',
        images: [timelineAssets[1], timelineAssets[4]]
      }
    ],
    2018: [
      {
        id: 1,
        title: 'New Campus Inauguration',
        description: 'Moved to a larger campus near Secretariat to accommodate our growing number of students and expanded faculty.',
        images: [timelineAssets[3], timelineAssets[1]]
      },
      {
        id: 2,
        title: 'Mock Interview Panel',
        description: 'Established a dedicated panel of retired bureaucrats to conduct realistic UPSC-style interviews.',
        images: [timelineAssets[0], timelineAssets[2]]
      }
    ],
    2019: [
      {
        id: 1,
        title: 'Top 100 Ranks Achievement',
        description: 'Our students secured multiple ranks in top 100 of UPSC examination, a testament to our teaching methodology.',
        images: [timelineAssets[4], timelineAssets[2], timelineAssets[0]]
      },
      {
        id: 2,
        title: 'Community Outreach',
        description: 'Launched programs to introduce civil service opportunities to undergraduate students across Kerala.',
        images: [timelineAssets[5], timelineAssets[1]]
      }
    ],
    2020: [
      {
        id: 1,
        title: 'Digital Transformation',
        description: 'Launched comprehensive online learning platform and mobile app to support remote learning during the pandemic.',
        images: [timelineAssets[5], timelineAssets[3]]
      },
      {
        id: 2,
        title: 'Virtual Interview Training',
        description: 'Pioneered virtual interview training programs to prepare students for the new online interview format.',
        images: [timelineAssets[0], timelineAssets[4]]
      }
    ],
    2021: [
      {
        id: 1,
        title: 'Research Wing Established',
        description: 'Created dedicated research wing to develop Kerala-specific and region-focused study materials for civil service aspirants.',
        images: [timelineAssets[0], timelineAssets[4], timelineAssets[2]]
      },
      {
        id: 2,
        title: 'Mental Health Support',
        description: 'Introduced comprehensive mental health support system with professional counselors to help students manage exam stress.',
        images: [timelineAssets[3], timelineAssets[1]]
      }
    ],
    2022: [
      {
        id: 1,
        title: 'Highest Success Rate',
        description: 'Achieved highest success rate among all civil service academies in Kerala with over 60% selection rate.',
        images: [timelineAssets[1], timelineAssets[5]]
      },
      {
        id: 2,
        title: 'Alumni Association',
        description: 'Formed the iLearn Alumni Association to foster networking and mentorship between successful officers and current aspirants.',
        images: [timelineAssets[2], timelineAssets[4]]
      }
    ],
    2023: [
      {
        id: 1,
        title: 'Expansion to New Cities',
        description: 'Opened new centers in Kochi and Kozhikode to serve aspirants across Kerala with the same quality education.',
        images: [timelineAssets[2], timelineAssets[0], timelineAssets[4]]
      },
      {
        id: 2,
        title: 'Sustainable Campus',
        description: 'Implemented eco-friendly practices across all campuses including solar power and rainwater harvesting systems.',
        images: [timelineAssets[3], timelineAssets[5]]
      }
    ],
    2024: [
      {
        id: 1,
        title: 'International Partnerships',
        description: 'Formed partnerships with international universities and civil service academies for knowledge exchange and global perspective.',
        images: [timelineAssets[3], timelineAssets[1]]
      },
      {
        id: 2,
        title: 'AI-Enhanced Learning',
        description: 'Introduced AI-powered adaptive learning tools to customize study plans based on individual strengths and weaknesses.',
        images: [timelineAssets[0], timelineAssets[5]]
      }
    ],
    2025: [
      {
        id: 1,
        title: 'Vision 2025',
        description: 'Setting new standards in civil service coaching with AI-powered personalized learning paths and expanded reach across South India.',
        images: [timelineAssets[4], timelineAssets[2], timelineAssets[5]]
      },
      {
        id: 2,
        title: 'Decade Celebration',
        description: 'Celebrating 10 years of academic excellence and thousands of successful civil servants serving the nation.',
        images: [timelineAssets[0], timelineAssets[1]]
      }
    ]
  };
  
  // Handle touch events for mobile swipe
  const handleTouchStart = (e: React.TouchEvent) => {
    setTouchStart(e.targetTouches[0].clientX);
  };
  
  const handleTouchMove = (e: React.TouchEvent) => {
    setTouchEnd(e.targetTouches[0].clientX);
  };
  
  // Timeline image touch handler
  const handleTimelineTouchEnd = () => {
    if (!currentEvent) return;
    
    // Minimum swipe distance: 50px
    if (touchStart - touchEnd > 50) {
      // Swipe left - next image
      if (activeImageIndex < currentEvent.images.length - 1) {
        setActiveImageIndex(activeImageIndex + 1);
      } else {
        setActiveImageIndex(0); // Cycle back to first image
      }
    }
    
    if (touchEnd - touchStart > 50) {
      // Swipe right - previous image
      if (activeImageIndex > 0) {
        setActiveImageIndex(activeImageIndex - 1);
      } else {
        setActiveImageIndex(currentEvent.images.length - 1); // Cycle to last image
      }
    }
    
    // Reset touch coordinates
    setTouchStart(0);
    setTouchEnd(0);
  };
  
  // Year navigation touch handler
  const handleYearTouchEnd = () => {
    // Minimum swipe distance: 50px
    if (touchStart - touchEnd > 50) {
      // Swipe left - next year
      const currentYearIndex = timelineYears.indexOf(activeYear);
      if (currentYearIndex < timelineYears.length - 1) {
        setActiveYear(timelineYears[currentYearIndex + 1]);
      } else {
        setActiveYear(timelineYears[0]); // Cycle back to first year
      }
      setActiveEventIndex(0); // Reset to first event in the year
      setActiveImageIndex(0); // Reset image index when changing year
    }
    
    if (touchEnd - touchStart > 50) {
      // Swipe right - previous year
      const currentYearIndex = timelineYears.indexOf(activeYear);
      if (currentYearIndex > 0) {
        setActiveYear(timelineYears[currentYearIndex - 1]);
      } else {
        setActiveYear(timelineYears[timelineYears.length - 1]); // Cycle to last year
      }
      setActiveEventIndex(0); // Reset to first event in the year
      setActiveImageIndex(0); // Reset image index when changing year
    }
    
    // Reset touch coordinates
    setTouchStart(0);
    setTouchEnd(0);
  };
  
  // Intro section touch handler
  const handleIntroTouchEnd = () => {
    // Minimum swipe distance: 50px
    if (touchStart - touchEnd > 50) {
      // Swipe left - next image
      if (introImageIndex < introImages.length - 1) {
        setIntroImageIndex(introImageIndex + 1);
      } else {
        setIntroImageIndex(0); // Cycle back to first image
      }
    }
    
    if (touchEnd - touchStart > 50) {
      // Swipe right - previous image
      if (introImageIndex > 0) {
        setIntroImageIndex(introImageIndex - 1);
      } else {
        setIntroImageIndex(introImages.length - 1); // Cycle to last image
      }
    }
    
    // Reset touch coordinates
    setTouchStart(0);
    setTouchEnd(0);
  };
  
  const coreValues = [
    {
      icon: 'ri-award-line',
      title: 'Pursuit of Excellence',
      description: 'We are committed to continuous improvement in our academic programs so every student can confidently pursue—and achieve—their dream of becoming a civil-service officer who serves Bharat.'
    },
    {
      icon: 'ri-home-heart-line',
      title: 'Hospitality',
      description: 'Preparation for the civil services is a defining chapter in a student\'s life. We aim to be their "home away from home," providing the emotional support and welcoming environment that sustains them throughout the journey.'
    }
  ];
  
  // Data for faculty members
  const facultyMembers = [
    {
      name: 'Dr. Rajendra Kumar',
      subjects: 'Indian Polity & Governance',
      image: 'https://randomuser.me/api/portraits/men/41.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=sample1'
    },
    {
      name: 'Dr. Priya Sharma',
      subjects: 'Economics & Development',
      image: 'https://randomuser.me/api/portraits/women/32.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=sample2'
    },
    {
      name: 'Prof. Amit Verma',
      subjects: 'Indian & World History',
      image: 'https://randomuser.me/api/portraits/men/28.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=sample3'
    },
    {
      name: 'Dr. Sunita Reddy',
      subjects: 'Geography & Environment',
      image: 'https://randomuser.me/api/portraits/women/45.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=sample4'
    },
    {
      name: 'Prof. Vivek Joshi',
      subjects: 'Science & Technology',
      image: 'https://randomuser.me/api/portraits/men/53.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=sample5'
    },
    {
      name: 'Ms. Anjali Gupta',
      subjects: 'Current Affairs & Essay',
      image: 'https://randomuser.me/api/portraits/women/58.jpg',
      videoUrl: 'https://www.youtube.com/watch?v=sample6'
    }
  ];
  
  // Get events for current year and the active event
  const yearEvents = timelineEvents[activeYear as keyof typeof timelineEvents] || [];
  
  // Ensure we have a valid event for every year, even if it wasn't defined
  const currentEvent = yearEvents.length > 0 
    ? yearEvents[activeEventIndex] 
    : {
        id: 1,
        title: `${activeYear} Growth Milestone`,
        description: `In ${activeYear}, iLearn IAS Academy continued to expand its programs and strengthen its commitment to providing quality civil service coaching.`,
        images: [timelineAssets[activeYear % timelineAssets.length]]
      };
  
  // Event navigation touch handler
  const handleEventTouchEnd = () => {
    // Minimum swipe distance: 50px
    if (touchStart - touchEnd > 50) {
      // Swipe left - next event
      if (activeEventIndex < yearEvents.length - 1) {
        setActiveEventIndex(activeEventIndex + 1);
      } else {
        setActiveEventIndex(0); // Cycle back to first event
      }
      setActiveImageIndex(0); // Reset image index when changing event
    }
    
    if (touchEnd - touchStart > 50) {
      // Swipe right - previous event
      if (activeEventIndex > 0) {
        setActiveEventIndex(activeEventIndex - 1);
      } else {
        setActiveEventIndex(yearEvents.length - 1); // Cycle to last event
      }
      setActiveImageIndex(0); // Reset image index when changing event
    }
    
    // Reset touch coordinates
    setTouchStart(0);
    setTouchEnd(0);
  };
  
  return (
    <>
      <Helmet>
        <title>About Us | iLearn IAS Academy</title>
        <meta name="description" content="Learn about iLearn IAS Academy's journey, mission, vision, values, and our commitment to civil service aspirants in Kerala." />
      </Helmet>
      
      <PageTransition>
        {/* Introduction Section with Swipeable Images */}
        <section className="pt-10 pb-14 bg-light-grey">
          <div className="container mx-auto px-4">
            <div className="flex flex-col md:flex-row items-center gap-8 md:gap-12">
              {/* Title Section - Always Comes First (Mobile Version) */}
              <div className="w-full mb-4 md:hidden">
                <h1 className="text-3xl font-extrabold tracking-tight mb-2 pt-2 relative group">
                  <div className="relative z-10">
                    <span className="block mb-1 text-primary-blue">Empowering <span className="text-primary-red">Dreams,</span></span>
                    <span className="block text-primary-blue">Nurturing <span className="text-primary-red">Leaders</span></span>
                  </div>
                  <div className="absolute inset-0 -bottom-1 -right-1 -left-1 z-0">
                    <span className="absolute inset-0 bg-gradient-to-br from-primary-blue/5 via-white to-primary-red/5 rounded-lg shadow-sm backdrop-blur-[1px]"></span>
                    <span className="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-primary-blue/40 to-primary-red/40 rounded-full transform origin-left transition-all duration-300 group-hover:scale-x-110"></span>
                  </div>
                </h1>
              </div>
              
              {/* Images - First on Desktop, Second on Mobile */}
              <div 
                className="md:w-2/5 order-1 md:order-1 relative mb-8 md:mb-0 w-full"
                onTouchStart={handleTouchStart}
                onTouchMove={handleTouchMove}
                onTouchEnd={handleIntroTouchEnd}
              >
                {/* Swipe Indicator for mobile - Material Design 3 style */}
                <div className="md:hidden absolute top-3 right-3 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-full text-sm font-medium text-primary-blue z-10 shadow-sm flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                  <span>Swipe</span>
                </div>
                
                {/* Swipeable image container with Material Design 3 styling */}
                <div className="rounded-xl overflow-hidden border border-gray-100 shadow-sm relative aspect-[4/5] group">
                  {/* Main image */}
                  <img 
                    src={introImages[introImageIndex]} 
                    alt={`iLearn IAS Academy - Image ${introImageIndex + 1}`} 
                    className="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  
                  {/* Left/Right swipe arrow indicators (mobile only) - Material Design 3 style */}
                  {introImages.length > 1 && (
                    <>
                      <button 
                        onClick={() => {
                          if (introImageIndex > 0) {
                            setIntroImageIndex(introImageIndex - 1);
                          } else {
                            setIntroImageIndex(introImages.length - 1);
                          }
                        }}
                        className="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-primary-blue hover:text-primary-red transition-all duration-200 md:hidden shadow-sm"
                        aria-label="Previous image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                          <path fillRule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clipRule="evenodd" />
                        </svg>
                      </button>
                      <button 
                        onClick={() => {
                          if (introImageIndex < introImages.length - 1) {
                            setIntroImageIndex(introImageIndex + 1);
                          } else {
                            setIntroImageIndex(0);
                          }
                        }}
                        className="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-primary-blue hover:text-primary-red transition-all duration-200 md:hidden shadow-sm"
                        aria-label="Next image"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                          <path fillRule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clipRule="evenodd" />
                        </svg>
                      </button>
                    </>
                  )}
                  
                  {/* Image counter indicator - Material Design 3 style */}
                  {introImages.length > 1 && (
                    <div className="absolute bottom-3 left-0 right-0 flex justify-center">
                      <div className="bg-gray-900/70 backdrop-blur-sm rounded-full px-3 py-1 text-white text-xs font-medium shadow-sm">
                        {introImageIndex + 1} / {introImages.length}
                      </div>
                    </div>
                  )}
                </div>
                
                {/* Image navigation dots - Material Design 3 style */}
                {introImages.length > 1 && (
                  <div className="flex justify-center mt-4 space-x-1.5">
                    {introImages.map((_, index) => (
                      <button 
                        key={index} 
                        onClick={() => setIntroImageIndex(index)}
                        className={`h-2 rounded-full transition-all duration-300 ${
                          introImageIndex === index 
                            ? 'bg-primary-blue w-8' 
                            : 'bg-gray-300 w-2 hover:bg-gray-400'
                        }`}
                        aria-label={`Go to image ${index + 1}`}
                      />
                    ))}
                  </div>
                )}
              </div>
              
              {/* Text content - Last on Mobile, Second on Desktop */}
              <div className="md:w-3/5 order-2 md:order-2">
                <h1 className="hidden md:block text-3xl lg:text-4xl font-extrabold tracking-tight mb-3 pt-3 relative group">
                  <div className="relative z-10">
                    <span className="whitespace-nowrap">
                      <span className="text-primary-blue">Empowering</span>
                      <span className="text-primary-red"> Dreams,</span>
                      <span className="text-primary-blue"> Nurturing</span>
                      <span className="text-primary-red"> Leaders</span>
                    </span>
                  </div>
                  <div className="absolute inset-0 -bottom-1 -right-1 -left-1 z-0">
                    <span className="absolute inset-0 bg-gradient-to-br from-primary-blue/5 via-white to-primary-red/5 rounded-lg shadow-sm backdrop-blur-[1px]"></span>
                    <span className="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-primary-blue/40 to-primary-red/40 rounded-full transform origin-left transition-all duration-300 group-hover:scale-x-110"></span>
                  </div>
                </h1>
                <p className="text-dark-grey mb-4 mt-2">
                  Since 2015, iLearn has been part of the dreams of hundreds of civil service aspirants, redefining coaching in Kerala with a decade of trust, innovation, and care.
                </p>
                <p className="text-dark-grey mb-4">
                  We understand that preparing for the civil services isn't just about studying—it's one of the most important journeys in a student's life. That's why we're not just an institute; we aim to be an extended family, offering both academic guidance and emotional support.
                </p>
                <p className="text-dark-grey mb-4">
                  At iLearn, we do things a little differently:
                </p>
                <ul className="list-disc pl-5 mb-4 space-y-2 text-dark-grey">
                  <li><span className="font-medium">Personal Mentorship:</span> Every student gets a mentor who not only helps with studies but also walks alongside them through every high and low.</li>
                  <li><span className="font-medium">Continuous Support:</span> Our support doesn't stop after one year—we stay with you until you reach your goal.</li>
                  <li><span className="font-medium">Integrated Learning Routine:</span> From comprehensive coverage of Prelims and Mains to regular prelims tests, mains answer writing, and full-length mains exams, we ensure you're fully prepared.</li>
                  <li><span className="font-medium">Supportive Environment:</span> With great classrooms and a caring team, we make sure you're never alone in this journey.</li>
                </ul>
                <p className="text-dark-grey mb-4">
                  Year after year, these efforts have helped iLearn achieve the highest success rate in Kerala among Prelims-cum-Mains classroom programs—a milestone no other institute has matched yet.
                </p>
                <p className="text-dark-grey font-medium">
                  And the journey continues! We're here to welcome every new aspirant who dreams of serving Bharat and leading the nation with pride.
                </p>
                
                {/* Desktop navigation controls - Material Design 3 style */}
                {introImages.length > 1 && (
                  <div className="hidden md:flex items-center gap-4 mt-6">
                    <button
                      onClick={() => {
                        if (introImageIndex > 0) {
                          setIntroImageIndex(introImageIndex - 1);
                        } else {
                          setIntroImageIndex(introImages.length - 1);
                        }
                      }}
                      className="flex items-center justify-center bg-primary-blue/10 hover:bg-primary-blue/15 text-primary-blue rounded-full py-1.5 px-3.5 transition-all duration-200 gap-1.5 group"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fillRule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clipRule="evenodd" />
                      </svg>
                      <span className="text-sm font-medium">Previous</span>
                    </button>
                    
                    <button
                      onClick={() => {
                        if (introImageIndex < introImages.length - 1) {
                          setIntroImageIndex(introImageIndex + 1);
                        } else {
                          setIntroImageIndex(0);
                        }
                      }}
                      className="flex items-center justify-center bg-primary-blue/10 hover:bg-primary-blue/15 text-primary-blue rounded-full py-1.5 px-3.5 transition-all duration-200 gap-1.5 group"
                    >
                      <span className="text-sm font-medium">Next</span>
                      <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fillRule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clipRule="evenodd" />
                      </svg>
                    </button>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
        
        {/* Our Journey Section - Material Design 3 Style */}
        <section className="py-20 bg-white relative overflow-hidden">
          <div className="absolute inset-0 bg-gradient-to-br from-primary-blue/5 to-primary-red/5"></div>
          
          <div className="container mx-auto px-4 relative z-10">
            {/* 1. Our Journey Heading */}
            <div className="text-center mb-8">
              <h2 className="text-3xl md:text-4xl font-extrabold tracking-tight text-primary-blue mb-2">
                Our <span className="text-primary-red">Journey</span>
              </h2>
              <div className="w-20 h-1 bg-primary-red mx-auto mb-4"></div>
              <p className="text-dark-grey/80 text-lg max-w-2xl mx-auto">
                Explore the milestones that have shaped our evolution since 2015
              </p>
            </div>
            
            {/* 2. Year Navigation - MD3 Style */}
            <div className="relative max-w-5xl mx-auto mb-6">
              <div className="flex justify-start overflow-x-auto hide-scrollbar py-2 px-4">
                {timelineYears.map((year) => (
                  <button
                    key={year}
                    onClick={() => {
                      setActiveYear(year);
                      setActiveImageIndex(0);
                      setActiveEventIndex(0);
                    }}
                    className={`flex-shrink-0 rounded-full text-center transition-all duration-300 mx-1.5 ${
                      activeYear === year
                        ? 'bg-primary-blue text-white shadow-md px-5 py-2.5 font-semibold scale-110'
                        : 'bg-white text-primary-blue hover:bg-gray-50 px-4 py-2 border border-gray-200'
                    }`}
                  >
                    {year}
                  </button>
                ))}
              </div>
            </div>
            
            {/* 3. Timeline Progress Bar - Material Design 3 Style */}
            <div className="max-w-4xl mx-auto mb-6 px-4">
              <div className="flex items-center gap-4">
                <span className="text-sm font-medium text-primary-blue">2015</span>
                <div className="h-2 bg-gray-200 rounded-full overflow-hidden flex-1 shadow-sm">
                  <div 
                    className="h-full bg-gradient-to-r from-primary-blue to-primary-red rounded-full"
                    style={{ 
                      width: `${((timelineYears.indexOf(activeYear) + 1) / timelineYears.length) * 100}%`,
                      transition: 'width 0.5s ease-in-out'
                    }}
                  ></div>
                </div>
                <span className="text-sm font-medium text-primary-red">2025</span>
              </div>
            </div>
            
            {/* 4. Milestone Tile Card - Enhanced Material Design 3 Style */}
            <div 
              className="relative max-w-4xl mx-auto"
            >
              {currentEvent && (
                <div 
                  className="relative bg-white rounded-xl shadow-md overflow-hidden transition-all duration-500 transform hover:shadow-lg cursor-grab active:cursor-grabbing"
                  onTouchStart={handleTouchStart}
                  onTouchMove={handleTouchMove}
                  onTouchEnd={handleYearTouchEnd}
                  onClick={() => {
                    // On click/tap, also allow year changes by advancing to the next year
                    const currentIndex = timelineYears.indexOf(activeYear);
                    const nextIndex = currentIndex < timelineYears.length - 1 ? currentIndex + 1 : 0;
                    setActiveYear(timelineYears[nextIndex]);
                    setActiveEventIndex(0); // Reset event index when changing years
                    setActiveImageIndex(0);
                  }}
                >
                  {/* Left/Right Swipe Indicators - Subtle visual guides */}
                  <div className="absolute left-0 inset-y-0 w-10 bg-gradient-to-r from-primary-blue/5 to-transparent flex items-center justify-center opacity-30 pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                      <path d="M15 18l-6-6 6-6"/>
                    </svg>
                  </div>
                  <div className="absolute right-0 inset-y-0 w-10 bg-gradient-to-l from-primary-red/5 to-transparent flex items-center justify-center opacity-30 pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                      <path d="M9 18l6-6-6-6"/>
                    </svg>
                  </div>
                  {/* Interactive Swipe Indicator - Enhanced for both mobile and desktop */}
                  <div className="absolute top-3 right-3 z-20 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-sm font-medium text-primary-blue shadow-sm border border-primary-blue/10 flex items-center gap-1.5 animate-pulse">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                      <path d="M14 5l-5 5 5 5"></path>
                      <path d="M5 12h14"></path>
                    </svg>
                    <span>Swipe Tile to Change Year</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                      <path d="M10 19l5-5-5-5"></path>
                      <path d="M5 12h14"></path>
                    </svg>
                  </div>
                  {/* New Layout Order: Year -> Milestone Heading -> Milestone Image -> Milestone Description */}
                  <div 
                    className="flex flex-col"
                    onTouchStart={handleTouchStart}
                    onTouchMove={handleTouchMove}
                    onTouchEnd={handleYearTouchEnd}
                  >
                    {/* Year and Milestone Heading Section */}
                    <div className="p-6 bg-white border-b border-gray-100">
                      {/* Year Badge and Multiple Events Indicator */}
                      <div className="flex justify-between items-center mb-4">
                        <div className="bg-primary-blue text-white text-lg font-bold px-4 py-1 rounded-md shadow-sm">
                          {activeYear}
                        </div>
                        
                        {/* Multiple Events Indicator (if applicable) */}
                        {yearEvents.length > 1 && (
                          <div className="flex items-center gap-1.5">
                            {yearEvents.map((_, index) => (
                              <button 
                                key={index} 
                                onClick={(e) => {
                                  e.stopPropagation();
                                  setActiveEventIndex(index);
                                  setActiveImageIndex(0);
                                }}
                                className={`w-2 h-2 rounded-full transition-all duration-200 ${
                                  activeEventIndex === index 
                                    ? 'bg-primary-red w-4' 
                                    : 'bg-gray-300 hover:bg-gray-400'
                                }`}
                                aria-label={`Event ${index + 1}`}
                              />
                            ))}
                          </div>
                        )}
                      </div>
                      
                      {/* Milestone Title with Decorative Elements */}
                      <h3 className="text-2xl md:text-3xl font-bold text-primary-blue mb-3">
                        {currentEvent.title}
                      </h3>
                      <div className="w-20 h-1 bg-primary-red"></div>
                    </div>
                    
                    {/* Milestone Image Section - Portrait Aspect Ratio (Instagram-like) */}
                    <div className="relative bg-light-grey">
                      <div className="aspect-[4/5] md:aspect-[4/5] relative overflow-hidden">
                        <img
                          src={currentEvent.images[activeImageIndex]}
                          alt={`${activeYear} - ${currentEvent.title}`}
                          className="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                        />
                        
                        {/* Navigation Arrows for Images */}
                        {currentEvent.images.length > 1 && (
                          <>
                            <button 
                              onClick={(e) => {
                                e.stopPropagation();
                                if (activeImageIndex > 0) {
                                  setActiveImageIndex(activeImageIndex - 1);
                                } else {
                                  setActiveImageIndex(currentEvent.images.length - 1);
                                }
                              }}
                              className="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-primary-blue hover:text-primary-red transition-all duration-200 shadow-md border border-gray-100"
                              aria-label="Previous image"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fillRule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clipRule="evenodd" />
                              </svg>
                            </button>
                            <button 
                              onClick={(e) => {
                                e.stopPropagation();
                                if (activeImageIndex < currentEvent.images.length - 1) {
                                  setActiveImageIndex(activeImageIndex + 1);
                                } else {
                                  setActiveImageIndex(0);
                                }
                              }}
                              className="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-primary-blue hover:text-primary-red transition-all duration-200 shadow-md border border-gray-100"
                              aria-label="Next image"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fillRule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clipRule="evenodd" />
                              </svg>
                            </button>
                          </>
                        )}
                        
                        {/* Image Count Indicator */}
                        {currentEvent.images.length > 1 && (
                          <div className="absolute bottom-4 left-1/2 -translate-x-1/2 bg-black/70 backdrop-blur-sm rounded-full px-3 py-1 text-white text-xs font-medium shadow-sm">
                            {activeImageIndex + 1} / {currentEvent.images.length}
                          </div>
                        )}
                      </div>
                      
                      {/* Image Navigation Dots */}
                      {currentEvent.images.length > 1 && (
                        <div className="py-3 flex justify-center bg-white border-t border-gray-100">
                          <div className="flex items-center space-x-1.5">
                            {currentEvent.images.map((_, index) => (
                              <button 
                                key={index} 
                                onClick={(e) => {
                                  e.stopPropagation();
                                  setActiveImageIndex(index);
                                }}
                                className={`h-2 rounded-full transition-all duration-200 ${
                                  activeImageIndex === index 
                                    ? 'bg-primary-red w-5' 
                                    : 'bg-gray-300 w-2 hover:bg-gray-400'
                                }`}
                                aria-label={`Image ${index + 1}`}
                              />
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                    
                    {/* Content Area with Description Only */}
                    <div className="p-6 bg-white flex flex-col">
                      {/* Milestone Description */}
                      <p className="text-gray-700 text-lg leading-relaxed mb-6">
                        {currentEvent.description}
                      </p>
                      
                      {/* Navigation Controls - Positioned at the center */}
                      <div className="flex justify-center gap-4 mt-auto">
                        {/* Previous Year Button */}
                        <button
                          onClick={(e) => {
                            e.stopPropagation();
                            const currentIndex = timelineYears.indexOf(activeYear);
                            const prevIndex = currentIndex > 0 ? currentIndex - 1 : timelineYears.length - 1;
                            setActiveYear(timelineYears[prevIndex]);
                            setActiveEventIndex(0); // Reset event index when changing years
                            setActiveImageIndex(0);
                          }}
                          className="flex items-center justify-center px-4 py-2 bg-white border border-primary-blue/20 rounded-full text-primary-blue hover:bg-primary-blue/5 transition-colors shadow-sm"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 mr-1.5" viewBox="0 0 20 20" fill="currentColor">
                            <path fillRule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clipRule="evenodd" />
                          </svg>
                          <span className="font-medium">Previous</span>
                        </button>
                        
                        {/* Next Year Button */}
                        <button
                          onClick={(e) => {
                            e.stopPropagation();
                            const currentIndex = timelineYears.indexOf(activeYear);
                            const nextIndex = currentIndex < timelineYears.length - 1 ? currentIndex + 1 : 0;
                            setActiveYear(timelineYears[nextIndex]);
                            setActiveEventIndex(0); // Reset event index when changing years
                            setActiveImageIndex(0);
                          }}
                          className="flex items-center justify-center px-4 py-2 bg-white border border-primary-red/20 rounded-full text-primary-red hover:bg-primary-red/5 transition-colors shadow-sm"
                        >
                          <span className="font-medium">Next</span>
                          <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4 ml-1.5" viewBox="0 0 20 20" fill="currentColor">
                            <path fillRule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clipRule="evenodd" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                  
                  {/* Visual Year Indicator for Card Swiping */}
                  <div className="bg-gradient-to-r from-primary-blue/10 to-primary-red/10 px-6 py-3 border-t border-gray-100">
                    <div className="flex justify-between items-center">
                      <div className="text-xs font-medium text-primary-blue">
                        Swipe to navigate timeline
                      </div>
                      <div className="flex items-center space-x-1">
                        {timelineYears.map((year) => (
                          <div 
                            key={year}
                            className={`w-1.5 h-1.5 rounded-full ${activeYear === year ? 'bg-primary-red' : 'bg-gray-300'}`}
                          />
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </section>
        
        {/* Core Values Section */}
        <section className="py-16 bg-light-grey">
          <div className="container mx-auto px-4">
            <div className="text-center mb-10">
              <h2 className="text-3xl md:text-4xl font-extrabold tracking-tight text-primary-blue mb-2">
                Core <span className="text-primary-red">Values</span>
              </h2>
              <div className="w-20 h-1 bg-primary-red mx-auto mb-4"></div>
              <p className="text-dark-grey/80 text-lg max-w-2xl mx-auto">
                The principles that guide our approach to education and student care
              </p>
            </div>
            
            {/* Core Values cards grid - Material Design 3 style */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
              {coreValues.map((value, index) => (
                <div key={index} className="bg-white p-8 rounded-xl border border-gray-100 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md group">
                  <div className="w-16 h-16 bg-gradient-to-r from-primary-blue/10 to-primary-red/10 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                    <i className={`${value.icon} text-primary-blue text-2xl`}></i>
                  </div>
                  <h3 className="text-2xl font-bold mb-4 text-primary-blue">{value.title}</h3>
                  <p className="text-dark-grey/90 text-lg leading-relaxed">
                    {value.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
        
        {/* Faculty Team Section */}
        <section className="py-10 md:py-14 bg-white">
          <div className="container mx-auto px-4">
            <div className="text-center mb-6">
              <h2 className="text-2xl md:text-3xl font-extrabold tracking-tight text-primary-blue mb-2">
                Our <span className="text-primary-red">Faculty</span>
              </h2>
              <div className="w-20 h-1 bg-primary-red mx-auto mb-3"></div>
              <p className="text-dark-grey/80 text-base max-w-2xl mx-auto">
                Meet your extended family—friends, philosophers, and guides who will accompany you on your journey.
              </p>
            </div>
            
            <div className="relative mt-6">
              {/* Navigation buttons */}
              {/* Faculty navigation buttons - Material Design 3 style */}
              <button 
                onClick={() => scrollCarousel(-1)}
                className="absolute left-0 top-1/2 transform -translate-y-1/2 -translate-x-1 z-10 bg-white/95 backdrop-blur-sm shadow-sm rounded-full p-2.5 md:p-3.5 hidden md:flex items-center justify-center text-primary-blue hover:text-primary-red transition-all duration-200 focus:outline-none"
                aria-label="Previous faculty"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M15 18l-6-6 6-6"/>
                </svg>
              </button>
              
              <div className="embla overflow-hidden" ref={emblaRef}>
                <div className="embla__container flex">
                  {facultyMembers.map((faculty, index) => (
                    <div key={index} className="embla__slide flex-none w-[280px] md:w-[320px] px-3">
                      {/* Faculty Card - Material Design 3 style */}
                      <div className="bg-white rounded-xl overflow-hidden border border-gray-100 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md group h-full">
                        <div className="relative overflow-hidden aspect-[3/3.5]">
                          <img 
                            src={faculty.image} 
                            alt={faculty.name}
                            className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          />
                          {/* Overlay with action button */}
                          <div className="absolute inset-0 bg-gradient-to-t from-primary-blue/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center">
                            <a 
                              href={faculty.videoUrl} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              className="mb-4 bg-white text-primary-red px-4 py-2 text-sm rounded-full flex items-center gap-1.5 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 font-medium shadow-sm"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clipRule="evenodd" />
                              </svg>
                              Watch Demo
                            </a>
                          </div>
                        </div>
                        {/* Card content with improved typography */}
                        <div className="p-5">
                          <h3 className="text-lg font-bold text-primary-blue">{faculty.name}</h3>
                          <p className="text-primary-red font-medium text-sm tracking-wide">{faculty.subjects}</p>
                          <div className="flex justify-between items-center mt-3">
                            <span className="text-xs font-medium px-2 py-0.5 bg-gray-100 rounded-full text-gray-600">Expert Faculty</span>
                            <a 
                              href={faculty.videoUrl}
                              target="_blank" 
                              rel="noopener noreferrer" 
                              className="text-primary-blue hover:text-primary-red transition-colors duration-300 flex items-center gap-1 text-sm group"
                            >
                              <span>View Demo</span>
                              <svg xmlns="http://www.w3.org/2000/svg" className="h-3 w-3 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
                                <path fillRule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clipRule="evenodd" />
                              </svg>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              
              <button 
                onClick={() => scrollCarousel(1)} 
                className="absolute right-0 top-1/2 transform -translate-y-1/2 translate-x-1 z-10 bg-white/95 backdrop-blur-sm shadow-sm rounded-full p-2.5 md:p-3.5 hidden md:flex items-center justify-center text-primary-blue hover:text-primary-red transition-all duration-200 focus:outline-none"
                aria-label="Next faculty"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </button>
              
              {/* Dots indicator for mobile - Material Design 3 style */}
              <div className="flex justify-center mt-5 md:hidden">
                {facultyMembers.map((_, index) => (
                  <button
                    key={index}
                    onClick={() => scrollToSlide(index)}
                    className={`h-2 rounded-full mx-1 transition-all duration-300 ${
                      selectedIndex === index 
                        ? 'bg-primary-red w-6' 
                        : 'bg-gray-300 w-2 hover:bg-gray-400'
                    }`}
                    aria-label={`Go to slide ${index + 1}`}
                  />
                ))}
              </div>
            </div>
          </div>
        </section>
      </PageTransition>
    </>
  );
};

export default AboutPage;
